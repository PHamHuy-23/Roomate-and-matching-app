# Copy this file to backend/.env and replace every placeholder locally.
# Never commit backend/.env.

# Supabase PostgreSQL. Copy the JDBC-compatible Session pooler values from
# Supabase Dashboard -> Connect. Session mode works on IPv4 and port 5432.
DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_POOL_MAX=5
DB_POOL_MIN=1
DB_CONNECTION_TIMEOUT_MS=30000
JPA_DDL_AUTO=update

# Application JWT secret (minimum 32 random characters).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional Supabase client metadata. Never use the service-role key in Flutter.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Cloudflare R2 S3 credentials. Scope object read/write access to these two buckets only.
# Public bucket: avatars and room-post images. Private bucket: chat/report images.
# Never enable r2.dev or a public custom domain on the private bucket.
R2_ENABLED=true
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=roommate-hub
R2_PRIVATE_BUCKET_NAME=YOUR_SEPARATE_PRIVATE_BUCKET_NAME
R2_PUBLIC_URL=https://media.example.com
R2_PRESIGN_DURATION_MINUTES=10
# Private GET links are short-lived (bounded to 1-5 minutes).
R2_PRIVATE_READ_DURATION_MINUTES=2
R2_MAX_UPLOAD_BYTES=5242880
